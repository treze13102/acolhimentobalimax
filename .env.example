# ---------------------------------------------------------------
# MODELO. Copie para ".env.local" e preencha LA, nunca aqui.
# Este arquivo VAI para o repositorio publico — mantenha-o vazio.
# ---------------------------------------------------------------

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# SEGREDO. Le e escreve tudo, ignorando RLS. So no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de criptografia dos relatos (32 bytes base64). Gere com: npm run chave
# Se for perdida, os relatos ja gravados ficam ilegiveis para sempre.
# Guarde uma copia no cofre de senhas, separada dos backups.
APP_KEY=

# Nome exibido no formulario
EMPRESA=Balimax Engenharia
